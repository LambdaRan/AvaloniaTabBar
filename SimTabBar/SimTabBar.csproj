<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 库要能被 NativeAOT 消费方引用：开 IsAotCompatible 会同时启用
         trim/AOT/single-file 分析器（IL2026/IL3050/IL2070 等），把「库里有反射但
         没标注」的情况在构建期暴露出来。当前零警告；标签头/图标取值只有
         HeaderBinding / IconSourceBinding（BindingBase，XAML 编译期绑定）与
         HeaderSelector / IconSourceSelector（强类型委托）两条车道，
         库内没有反射路径实现。改动后请跑：
         dotnet build SimTabBar/SimTabBar.csproj -p:IsAotCompatible=true -warnaserror -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SimTabBar</PackageId>
    <!-- VersionPrefix (not Version) so that `dotnet pack -p:VersionSuffix=ci.N`
         produces 0.4.0-ci.N. An explicit <Version> would silently swallow the
         suffix and every CI run would publish the same version.

         这里是**本地构建的程序集版本下限**，发布线走到哪就跟到哪：它停在
         0.2.0 时，不带 -p:Version 的构建（本地 pack、以及 CI 的 build 步骤）
         会把 DLL 戳成 0.2.0 —— 0.3.1 包里 DLL 写着 0.2.0 的另一半原因就在这。
         正式的版本号由 CI 的 build/pack 两步用 -p:Version 覆盖（见 build.yml）。 -->
    <VersionPrefix>0.4.0</VersionPrefix>
    <Authors>LambdaRan</Authors>
    <Description>A VS Code-style tab bar control library for Avalonia. Features multiple width modes, close button modes, context menus, keyboard navigation, pinned tabs, and theme support.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/LambdaRan/AvaloniaTabBar</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LambdaRan/AvaloniaTabBar.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>avalonia;avaloniaui;tabbar;tab;control;ui;xaml</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- No PrivateAssets: Avalonia is a public dependency of this control library
         and must flow to consumers. A fixed range keeps builds reproducible and
         stops the package from silently loading against an incompatible major. -->
    <PackageReference Include="Avalonia" Version="[12.1.0,13.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimTabBar.Tests" />
  </ItemGroup>

</Project>
