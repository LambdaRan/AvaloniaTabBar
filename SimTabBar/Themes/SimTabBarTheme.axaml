<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SimTabBar.Controls">

    <!-- ==================== Resource Tokens ==================== -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Default = Dark (complete baseline) -->
                <ResourceDictionary x:Key="Default">
                    <!-- Colors (10) -->
                    <SolidColorBrush x:Key="SimTabBarBackground" Color="#252526" />
                    <SolidColorBrush x:Key="SimTabBarBottomBorderBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="SimTabBarItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="SimTabBarItemBackgroundSelected" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="SimTabBarItemBackgroundPointerOver" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="SimTabBarItemBackgroundSelectedPointerOver" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="SimTabBarItemForeground" Color="#969696" />
                    <SolidColorBrush x:Key="SimTabBarItemForegroundSelected" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SimTabBarItemActiveIndicatorBrush" Color="#007ACC" />
                    <SolidColorBrush x:Key="SimTabBarCloseButtonBackgroundPointerOver" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="SimTabBarSeparatorBrush" Color="#606060" />

                    <!-- Dimensions (7) -->
                    <x:Double x:Key="SimTabBarItemMinHeight">35</x:Double>
                    <x:Double x:Key="SimTabBarItemMinWidth">100</x:Double>
                    <x:Double x:Key="SimTabBarItemMaxWidth">240</x:Double>
                    <x:Double x:Key="SimTabBarItemCompactWidth">36</x:Double>
                    <Thickness x:Key="SimTabBarItemPadding">10,0,10,0</Thickness>
                    <x:Double x:Key="SimTabBarItemCloseButtonSize">16</x:Double>
                    <x:Double x:Key="SimTabBarActiveIndicatorHeight">2</x:Double>
                </ResourceDictionary>

                <!-- Light = color overrides only, dimensions inherited from Default -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SimTabBarBackground" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="SimTabBarBottomBorderBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="SimTabBarItemBackgroundSelected" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SimTabBarItemBackgroundPointerOver" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="SimTabBarItemBackgroundSelectedPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SimTabBarItemForeground" Color="#616161" />
                    <SolidColorBrush x:Key="SimTabBarItemForegroundSelected" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="SimTabBarCloseButtonBackgroundPointerOver" Color="#D4D4D4" />
                    <SolidColorBrush x:Key="SimTabBarSeparatorBrush" Color="#E5E5E5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ==================== TabBar ControlTheme ==================== -->
            <ControlTheme x:Key="{x:Type controls:TabBar}" TargetType="controls:TabBar">
                <Setter Property="Background" Value="{DynamicResource SimTabBarBackground}" />
                <!-- TabBar is focusable so Ctrl+Tab / Ctrl+F4 reach OnKeyDown;
                     suppress the focus rectangle that would otherwise be drawn. -->
                <Setter Property="FocusAdorner" Value="{x:Null}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid RowDefinitions="Auto,*"
                              Background="{TemplateBinding Background}">

                            <!-- Row 0: Tab strip -->
                            <Grid x:Name="PART_TabStripGrid"
                                  Grid.Row="0"
                                  ColumnDefinitions="Auto,*,Auto,Auto"
                                  Height="35">

                                <!-- Header -->
                                <ContentPresenter x:Name="PART_HeaderPresenter"
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding TabStripHeader}"
                                                  ContentTemplate="{TemplateBinding TabStripHeaderTemplate}"
                                                  VerticalAlignment="Center"
                                                  Margin="4,0,0,0" />

                                <!-- Scrollable tab items -->
                                <Grid Grid.Column="1">
                                    <ScrollViewer x:Name="PART_TabStripScrollViewer"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                        HorizontalAlignment="Left">
                                            <ItemsPresenter.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsPresenter.ItemsPanel>
                                        </ItemsPresenter>
                                    </ScrollViewer>

                                    <!-- Overlay scroll thumb -->
                                    <Border x:Name="PART_ScrollThumb"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Left"
                                            Height="3"
                                            MinWidth="24"
                                            CornerRadius="1.5"
                                            Background="#B0AAAAAA"
                                            IsVisible="False"
                                            Opacity="0"
                                            Cursor="Hand" />
                                </Grid>

                                <!-- Footer -->
                                <ContentPresenter x:Name="PART_FooterPresenter"
                                                  Grid.Column="2"
                                                  Content="{TemplateBinding TabStripFooter}"
                                                  ContentTemplate="{TemplateBinding TabStripFooterTemplate}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0" />

                                <!-- Add button -->
                                <Button x:Name="PART_AddButton"
                                        Grid.Column="3"
                                        Width="28" Height="28"
                                        Margin="4,0,4,0"
                                        VerticalAlignment="Center"
                                        Content="+"
                                        FontSize="16"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Arrow"
                                        IsVisible="{TemplateBinding IsAddTabButtonVisible}" />
                            </Grid>

                            <!-- Bottom border line -->
                            <Border Grid.Row="0"
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource SimTabBarBottomBorderBrush}" />

                            <!-- Row 1: Content area -->
                            <ContentPresenter x:Name="PART_TabContentPresenter"
                                              Grid.Row="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ==================== TabBarItem ControlTheme ==================== -->
            <ControlTheme x:Key="{x:Type controls:TabBarItem}" TargetType="controls:TabBarItem">
                <!-- Default properties -->
                <Setter Property="Background" Value="{DynamicResource SimTabBarItemBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource SimTabBarItemForeground}" />
                <Setter Property="MinHeight" Value="{DynamicResource SimTabBarItemMinHeight}" />
                <Setter Property="MinWidth" Value="{DynamicResource SimTabBarItemMinWidth}" />
                <Setter Property="Padding" Value="{DynamicResource SimTabBarItemPadding}" />

                <!-- Template -->
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid>
                            <Border x:Name="PART_RootBorder"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="6,6,0,0">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Icon -->
                                    <ContentPresenter x:Name="PART_IconPresenter"
                                                      Grid.Column="0"
                                                      Width="16" Height="16"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center"
                                                      IsVisible="False" />

                                    <!-- Header -->
                                    <ContentPresenter x:Name="PART_HeaderPresenter"
                                                      Grid.Column="1"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      TextBlock.Foreground="{TemplateBinding Foreground}" />

                                    <!-- Close Button -->
                                    <Button x:Name="PART_CloseButton"
                                            Grid.Column="2"
                                            Width="{DynamicResource SimTabBarItemCloseButtonSize}"
                                            Height="{DynamicResource SimTabBarItemCloseButtonSize}"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Content="✕"
                                            FontSize="10"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Arrow"
                                            Classes="TabCloseButton" />
                                </Grid>
                            </Border>

                            <!-- Active indicator (top overlay - does not consume layout space) -->
                            <Border x:Name="PART_ActiveIndicator"
                                    VerticalAlignment="Top"
                                    Height="{DynamicResource SimTabBarActiveIndicatorHeight}"
                                    Background="{DynamicResource SimTabBarItemActiveIndicatorBrush}"
                                    CornerRadius="6,6,0,0"
                                    IsVisible="False" />

                            <!-- Separator (right edge) -->
                            <Border x:Name="PART_Separator"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="1"
                                    Height="16"
                                    Background="{DynamicResource SimTabBarSeparatorBrush}"
                                    IsVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter>

                <!-- Selected state -->
                <Style Selector="^:selected">
                    <Setter Property="Background" Value="{DynamicResource SimTabBarItemBackgroundSelected}" />
                    <Setter Property="Foreground" Value="{DynamicResource SimTabBarItemForegroundSelected}" />
                </Style>

                <!-- Show active indicator when selected -->
                <Style Selector="^:selected /template/ Border#PART_ActiveIndicator">
                    <Setter Property="IsVisible" Value="True" />
                </Style>

                <!-- Compact mode: narrow the tab and hide header text.
                     MinWidth must be relaxed here as well: the base MinWidth setter
                     above (100) would otherwise clamp the 36px width set in code. -->
                <Style Selector="^:compact">
                    <Setter Property="MinWidth" Value="{DynamicResource SimTabBarItemCompactWidth}" />
                </Style>
                <Style Selector="^:compact /template/ ContentPresenter#PART_HeaderPresenter">
                    <Setter Property="IsVisible" Value="False" />
                </Style>

                <!-- Compact mode: drop the horizontal padding so the 36px tab
                     can still fit the 16px icon slot. -->
                <Style Selector="^:compact /template/ Border#PART_RootBorder">
                    <Setter Property="Padding" Value="0" />
                </Style>

                <!-- Compact mode: the icon is the only visible content, so let it
                     span all three columns and centre it in the 36px tab. -->
                <Style Selector="^:compact /template/ ContentPresenter#PART_IconPresenter">
                    <Setter Property="Grid.ColumnSpan" Value="3" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>

                <!-- Pointer over (unselected) -->
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{DynamicResource SimTabBarItemBackgroundPointerOver}" />
                </Style>

                <!-- Selected + pointer over (declared AFTER ^:pointerover to win precedence) -->
                <Style Selector="^:selected:pointerover">
                    <Setter Property="Background" Value="{DynamicResource SimTabBarItemBackgroundSelectedPointerOver}" />
                </Style>

                <!-- Close button hover -->
                <Style Selector="^ /template/ Button.TabCloseButton:pointerover">
                    <Setter Property="Background" Value="{DynamicResource SimTabBarCloseButtonBackgroundPointerOver}" />
                </Style>

                <!-- Show separator when separator pseudo-class is true -->
                <Style Selector="^:separator /template/ Border#PART_Separator">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

</Styles>
