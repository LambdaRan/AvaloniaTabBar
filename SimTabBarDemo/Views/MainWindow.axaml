<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SimTabBarDemo.Views"
        x:Class="SimTabBarDemo.Views.MainWindow"
        Title="SimTabBar Demo"
        Width="1000" Height="700">

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="200,*">

            <!-- Left navigation -->
            <ListBox x:Name="SceneList"
                     Grid.Column="0"
                     SelectionChanged="OnSceneSelectionChanged"
                     Margin="0,0,1,0"
                     BorderThickness="0,0,1,0"
                     BorderBrush="{DynamicResource SimTabBarBottomBorderBrush}">
                <ListBoxItem Content="📋 基础用法" IsSelected="True" />
                <ListBoxItem Content="🔗 数据绑定" />
                <ListBoxItem Content="✖ 关闭模式" />
                <ListBoxItem Content="↔ 宽度模式" />
                <ListBoxItem Content="📎 Header/Footer" />
                <ListBoxItem Content="⌨ 键盘快捷键" />
                <ListBoxItem Content="📌 不可关闭标签" />
                <ListBoxItem Content="📜 右键菜单" />
            </ListBox>

            <!-- Right content area -->
            <Panel x:Name="SceneContainer" Grid.Column="1" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Height="24" Background="{DynamicResource SimTabBarBottomBorderBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="SimTabBar Demo — Avalonia UI" VerticalAlignment="Center" Margin="8,0" FontSize="11" />
                <Button Grid.Column="1" Content="🌙/☀️" FontSize="11" Padding="4,0"
                        Background="Transparent" BorderThickness="0"
                        Click="OnThemeToggleClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
