<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SimTabBar.Controls"
             x:Class="SimTabBarDemo.Views.BasicTabPage">

    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="基础用法：声明式标签页" FontSize="18" Margin="16,16,16,8" />

        <controls:TabBar Grid.Row="1"
                          x:Name="BasicSimTabBar"
                          AddTabButtonClick="OnAddTabButtonClick"
                          Margin="16">

            <controls:TabBarItem Header="首页">
                <controls:TabBarItem.Content>
                    <TextBlock Text="这是首页内容" Margin="16" FontSize="14" />
                </controls:TabBarItem.Content>
            </controls:TabBarItem>

            <controls:TabBarItem Header="文档">
                <controls:TabBarItem.Content>
                    <TextBlock Text="这是文档内容" Margin="16" FontSize="14" />
                </controls:TabBarItem.Content>
            </controls:TabBarItem>

            <controls:TabBarItem Header="设置">
                <controls:TabBarItem.Content>
                    <TextBlock Text="这是设置内容" Margin="16" FontSize="14" />
                </controls:TabBarItem.Content>
            </controls:TabBarItem>

        </controls:TabBar>
    </Grid>
</UserControl>
